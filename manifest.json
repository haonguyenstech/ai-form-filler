{
  "manifest_version": 3,
  "name": "AI Form Filler",
  "version": "2.7.0",
  "description": "Floating bubble that analyzes and auto-fills every form field on the page using a free AI model — no API key, no setup required.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "AI Form Filler — toggle bubble"
  },
  "commands": {
    "toggle-dialog": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "Command+Shift+F" },
      "description": "Toggle the AI Form Filler dialog"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
